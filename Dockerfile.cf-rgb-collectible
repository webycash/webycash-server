# Cloudflare Containers image for the RGB21 collectible flavor.
FROM rust:1.92-alpine AS build
RUN apk add --no-cache musl-dev pkgconfig openssl-dev openssl-libs-static
WORKDIR /app
COPY . .
# BuildKit cache mounts so the cargo registry + target dir survive
# across builds. The cargo build of one flavor seeds the cache for the
# next; warm-cache builds finish in ~1–2 min instead of ~10.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/app/target,sharing=locked \
    cargo build --release -p webycash-server-rgb-collectible \
    && strip target/release/webycash-server-rgb-collectible \
    && cp target/release/webycash-server-rgb-collectible /server

FROM alpine:3.21
RUN apk add --no-cache ca-certificates wget
COPY --from=build /server /usr/local/bin/server
EXPOSE 8080
ENV WEBCASH_BIND_ADDR=0.0.0.0:8080 \
    WEBCASH_DB_BACKEND=worker_proxy \
    WEBCASH_MODE=testnet \
    RUST_LOG=info

# RGB21 binaries don't expose /api/v1/target (no mining). Probe /terms instead.
HEALTHCHECK --interval=15s --timeout=3s --start-period=8s --retries=3 \
    CMD wget -q -O - http://127.0.0.1:8080/terms | grep -q Webycash || exit 1

ENTRYPOINT ["server"]
