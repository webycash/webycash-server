{
  "name": "webycash-cf-container-voucher",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "render": "node ../../scripts/render-wrangler.mjs",
    "deploy": "node ../../scripts/render-wrangler.mjs --env testnet && wrangler deploy -c wrangler.generated.toml",
    "deploy:prod": "node ../../scripts/render-wrangler.mjs --env production && wrangler deploy -c wrangler.generated.toml --env production",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test ../shared/d1-bridge.test.ts ../../scripts/render-wrangler.test.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.156.0"
  }
}
